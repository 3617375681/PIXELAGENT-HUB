NODE_ENV=development
# LLM provider: mock | openai | anthropic | deepseek | kimi | ollama | custom-openai-compat
# mock 为无 key 演示模式：即时结构化响应，不发起外网 LLM 请求。真实生成时改为所选 provider 并填写下方对应密钥。
# 未设置任何 provider 且没有密钥时，服务不会静默选用某个厂商，而是报告“未配置 LLM provider”。
LLM_PROVIDER=mock
# OFFLINE=true       # 等价于强制走 mock LLM（若未显式设置 LLM_PROVIDER）
# MOCK_LLM_DELAY_MS=1500   # mock 每次响应前等待（毫秒），便于现场演示看清各阶段；默认 0
#
# 单 Agent 执行超时（Orchestrator.runTask）：未在 Agent 上设置 timeout 时使用此默认值（毫秒）
AGENT_DEFAULT_TIMEOUT_MS=120000
# 重推理类 Agent（Writer / Researcher / Senior Editor / Coder）在代码中已固定 180s，可用本值调其余 Agent
#
# 按 Agent 覆盖模型路由（可选）：未设置时所有 Agent 共用全局 LLM_PROVIDER / 各厂商 *_MODEL
# AGENT_REVIEWER_LLM_PROVIDER=ollama
# AGENT_REVIEWER_LLM_MODEL=qwen3:14b
# AGENT_WRITER_LLM_PROVIDER=deepseek
# AGENT_WRITER_LLM_MODEL=deepseek-chat
# Optional: override company-mode records directory (used by tests / alternate data roots)
# RECORDS_ROOT_OVERRIDE=
RECORDS_API_PORT=3100
RECORDS_API_KEY=replace-with-strong-api-key
ALLOW_UNAUTH_IN_DEV=true
RUN_TIMEOUT_MS=120000
# Optional per-mode HTTP/run timeout overrides (ms). When unset, RUN_TIMEOUT_MS applies.
# RUN_TIMEOUT_MS_PIPELINE=180000
# RUN_TIMEOUT_MS_PARALLEL=
# RUN_TIMEOUT_MS_DEBATE=
# RUN_TIMEOUT_MS_VOTE=
# RUN_TIMEOUT_MS_ROUNDTABLE=
# RUN_TIMEOUT_MS_COMPANY=
# Software Studio defaults to 8 minutes for planning, generation and build revisions.
# RUN_TIMEOUT_MS_STUDIO=480000
# Optional API project directory; default <RECORDS_ROOT>/studio. CLI uses records/software-studio.
# STUDIO_ROOT_OVERRIDE=
# Independent server-side browser checks require Node 20+ and an installed Chromium.
# ENABLE_STUDIO_BROWSER_CHECKS=true
# STUDIO_BROWSER_EXECUTABLE=    # optional administrator-controlled executable path
MAX_RUN_CONCURRENCY=3
RUN_RATE_LIMIT_PER_MINUTE=30
RUN_QUEUE_SIZE=20
RUN_MAX_RETRIES=0
USD_PER_1K_TOKENS=0.002

# Optional embedding retriever via local Ollama (requires a running Ollama with the embed model)
ENABLE_EMBEDDING_RETRIEVER=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3:14b
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=80

# Provider keys — fill in only the one selected by LLM_PROVIDER.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k2p5
# OLLAMA_MODEL=qwen3:14b   # uses OLLAMA_BASE_URL above
# Any OpenAI-compatible endpoint (LLM_PROVIDER=custom-openai-compat)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ResearchAgent defaults to key-free DuckDuckGo HTML search when no search API key is configured.
# SEARCH_PROVIDER=duckduckgo forces this mode even when API keys exist.
# At least 3 distinct sources with excerpts are required. Search failures do not fall back to mock.
# SEARCH_PROVIDER=mock is synthetic and cannot be used for real ResearchAgent tasks.
# Self-hosted SearXNG aggregates search engines without a paid search key (JSON must be enabled).
# SEARCH_PROVIDER=searxng
# SEARXNG_BASE_URL=http://127.0.0.1:8888
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=

