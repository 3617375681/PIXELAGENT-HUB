# Leave empty during `npm run dev` to use Vite proxy → Records API (see vite.config.ts).
# Set to http://127.0.0.1:3100 when the UI is not served by Vite (e.g. static preview + remote API).
VITE_RECORDS_API_URL=
# Prefer the dashboard's "API 连接" button. A value here is embedded in public build output.
# Runtime credentials are scoped to the API address and stored in this tab's session only.
VITE_RECORDS_API_KEY=
