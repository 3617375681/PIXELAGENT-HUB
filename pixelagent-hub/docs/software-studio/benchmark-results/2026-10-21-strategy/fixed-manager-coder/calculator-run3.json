      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Two-Number Calculator</title>\n  <style>\n    :root {\n      --bg: #1a1a2e;\n      --card: #16213e;\n      --accent: #e94560;\n      --text: #f0f0f0;\n      --border: #0f3460;\n    }\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: var(--bg);\n      color: var(--text);\n      font-family: 'Courier New', Courier, monospace;\n      font-size: 18px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100vh;\n      padding: 16px;\n    }\n    .calculator {\n      background: var(--card);\n      border: 4px solid var(--border);\n      padding: 24px;\n      width: 100%;\n      max-width: 400px;\n      box-shadow: 8px 8px 0 var(--border);\n    }\n    h1 {\n      font-size: 1.5rem;\n      text-align: center;\n      margin-bottom: 20px;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      color: var(--accent);\n      text-shadow: 2px 2px 0 var(--border);\n    }\n    .field {\n      margin-bottom: 16px;\n    }\n    label {\n      display: block;\n      margin-bottom: 6px;\n      font-weight: bold;\n      text-transform: uppercase;\n      font-size: 0.9rem;\n      letter-spacing: 1px;\n    }\n    input, select, button {\n      font-family: inherit;\n      font-size: 1rem;\n      padding: 10px 12px;\n      width: 100%;\n      border: 3px solid var(--border);\n      background: var(--bg);\n      color: var(--text);\n      border-radius: 0;\n      transition: background 0.1s, transform 0.1s;\n    }\n    input:focus, select:focus, button:focus {\n      outline: 3px solid var(--accent);\n      outline-offset: 2px;\n    }\n    button {\n      background: var(--accent);\n      color: var(--bg);\n      font-weight: bold;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n      cursor: pointer;\n      margin-top: 8px;\n      border-color: var(--accent);\n    }\n    button:hover {\n      background: #ff6b81;\n      border-color: #ff6b81;\n    }\n    button:active {\n      transform: translate(2px, 2px);\n      box-shadow: none;\n    }\n    .result-display {\n      background: var(--bg);\n      border: 3px solid var(--border);\n      padding: 16px;\n      margin-top: 20px;\n      font-size: 1.8rem;\n      text-align: right;\n      min-height: 60px;\n      word-break: break-all;\n      display: flex;\n      align-items: center;\n      justify-content: flex-end;\n    }\n    [hidden] { display: none !important; }\n    @media (max-width: 400px) {\n      .calculator { padding: 16px; }\n      h1 { font-size: 1.2rem; }\n      input, select, button { font-size: 0.9rem; padding: 8px; }\n      .result-display { font-size: 1.4rem; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"calculator\">\n    <h1>Pixel Calc</h1>\n    <div class=\"field\">\n      <label for=\"left\">Left Number</label>\n      <input type=\"number\" id=\"left\" step=\"any\" placeholder=\"e.g. 5\" aria-label=\"Left number\">\n    </div>\n    <div class=\"field\">\n      <label for=\"right\">Right Number</label>\n      <input type=\"number\" id=\"right\" step=\"any\" placeholder=\"e.g. 3\" aria-label=\"Right number\">\n    </div>\n    <div class=\"field\">\n      <label for=\"operation\">Operation</label>\n      <select id=\"operation\" aria-label=\"Operation\">\n        <option value=\"add\">Add (+)</option>\n        <option value=\"subtract\">Subtract (−)</option>\n        <option value=\"multiply\">Multiply (×)</option>\n        <option value=\"divide\">Divide (÷)</option>\n      </select>\n    </div>\n    <button id=\"calculate\" type=\"button\">Calculate</button>\n    <div class=\"result-display\" id=\"result\" aria-live=\"polite\">0</div>\n  </main>\n  <script>\n    (function() {\n      const left = document.getElementById('left');\n      const right = document.getElementById('right');\n      const operation = document.getElementById('operation');\n      const calculate = document.getElementById('calculate');\n      const result = document.getElementById('result');\n\n      function compute() {\n        const l = parseFloat(left.value);\n        const r = parseFloat(right.value);\n        const op = operation.value;\n\n        if (left.value.trim() === '' || right.value.trim() === '' || !isFinite(l) || !isFinite(r)) {\n          result.textContent = 'Error';\n          return;\n        }\n\n        let res;\n        switch (op) {\n          case 'add': res = l + r; break;\n          case 'subtract': res = l - r; break;\n          case 'multiply': res = l * r; break;\n          case 'divide':\n            if (r === 0) { result.textContent = 'Error'; return; }\n            res = l / r;\n            break;\n          default: result.textContent = 'Error'; return;\n        }\n\n        if (!isFinite(res)) {\n          result.textContent = 'Error';\n        } else {\n          result.textContent = res;\n        }\n      }\n\n      calculate.addEventListener('click', compute);\n    })();\n  </script>\n</body>\n</html>",
      "description": ""
