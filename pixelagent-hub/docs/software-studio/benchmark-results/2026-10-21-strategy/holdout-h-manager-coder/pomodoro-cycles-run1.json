    {
      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Interval Trainer</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Pixel Interval Trainer</h1>\n    <form id=\"settings-form\" novalidate>\n      <div class=\"field\">\n        <label for=\"work-seconds\">Work (seconds)</label>\n        <input type=\"number\" id=\"work-seconds\" min=\"1\" max=\"999\" value=\"30\" required>\n      </div>\n      <div class=\"field\">\n        <label for=\"rest-seconds\">Rest (seconds)</label>\n        <input type=\"number\" id=\"rest-seconds\" min=\"1\" max=\"999\" value=\"15\" required>\n      </div>\n      <div class=\"field\">\n        <label for=\"rounds\">Rounds</label>\n        <input type=\"number\" id=\"rounds\" min=\"1\" max=\"99\" value=\"5\" required>\n      </div>\n      <button type=\"submit\" id=\"start-btn\">Start</button>\n    </form>\n    <div id=\"timer-display\" class=\"display\" aria-live=\"polite\" aria-atomic=\"true\">\n      <div class=\"phase\" id=\"phase\">Ready</div>\n      <div class=\"time\" id=\"time\">--</div>\n      <div class=\"round\" id=\"round\">Round 0 / 0</div>\n    </div>\n    <div id=\"completion-message\" class=\"completion\" hidden aria-live=\"assertive\">Workout complete</div>\n    <div id=\"error-message\" class=\"error\" hidden aria-live=\"assertive\"></div>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
      "description": "Main page structure with form controls, timer display, completion and error regions. Added novalidate so custom validation messages appear instead of native browser validation blocking submit."
    },
    {
      "path": "style.css",
      "content": ":root {\n  --bg: #1a1a2e;\n  --card-bg: #16213e;\n  --accent: #e94560;\n  --accent-hover: #ff6b81;\n  --text: #eaeaea;\n  --text-muted: #a0a0b0;\n  --border: #0f3460;\n  --success: #4ecca3;\n  --error: #e94560;\n  --focus: #f9c74f;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nbody {\n  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  font-size: 16px;\n  background: var(--bg);\n  color: var(--text);\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 1rem;\n  line-height: 1.5;\n}\n\n.card {\n  background: var(--card-bg);\n  border: 2px solid var(--border);\n  border-radius: 12px;\n  padding: 2rem 1.5rem;\n  width: 100%;\n  max-width: 420px;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\n  text-align: center;\n}\n\nh1 {\n  font-size: 1.5rem;\n  margin-bottom: 1.5rem;\n  color: var(--accent);\n  letter-spacing: 0.5px;\n}\n\n.field {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  margin-bottom: 1rem;\n}\n\nlabel {\n  font-size: 0.95rem;\n  margin-bottom: 0.35rem;\n  color: var(--text-muted);\n}\n\ninput[type=\"number\"] {\n  width: 100%;\n  padding: 0.6rem 0.75rem;\n  font-size: 1rem;\n  background: var(--bg);\n  border: 2px solid var(--border);\n  border-radius: 8px;\n  color: var(--text);\n  transition: border-color 0.15s;\n}\n\ninput[type=\"number\"]:focus {\n  outline: none;\n  border-color: var(--focus);\n}\n\nbutton {\n  width: 100%;\n  padding: 0.75rem 1rem;\n  font-size: 1.1rem;\n  font-weight: 600;\n  background: var(--accent);\n  color: #fff;\n  border: none;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: background 0.15s, transform 0.1s;\n  margin-top: 0.5rem;\n}\n\nbutton:hover {\n  background: var(--accent-hover);\n}\n\nbutton:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n}\n\nbutton:active {\n  transform: scale(0.97);\n}\n\nbutton:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.display {\n  margin-top: 1.5rem;\n  padding: 1.25rem 0.75rem;\n  background: var(--bg);\n  border: 2px solid var(--border);\n  border-radius: 8px;\n}\n\n.phase {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: var(--accent);\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\n.time {\n  font-size: 3rem;\n  font-weight: 700;\n  margin: 0.25rem 0;\n  font-variant-numeric: tabular-nums;\n}\n\n.round {\n  font-size: 0.95rem;\n  color: var(--text-muted);\n}\n\n.completion {\n  margin-top: 1rem;\n  padding: 0.75rem;\n  background: var(--success);\n  color: #0b1a14;\n  font-weight: 700;\n  border-radius: 8px;\n  font-size: 1.1rem;\n}\n\n.error {\n  margin-top: 1rem;\n  padding: 0.75rem;\n  background: var(--error);\n  color: #fff;\n  border-radius: 8px;\n  font-size: 0.95rem;\n}\n\n@media (max-width: 400px) {\n  .card {\n    padding: 1.5rem 1rem;\n  }\n  h1 {\n    font-size: 1.3rem;\n  }\n  .time {\n    font-size: 2.5rem;\n  }\n}",
      "description": "Unchanged stylesheet."
