  "files": [
    {
      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Pixel Sleep Bar Chart</title>\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Sleep Tracker</h1>\n    <p class=\"subtitle\">Enter hours slept each night (0–12).</p>\n\n    <form id=\"sleep-form\" class=\"inputs\" novalidate>\n      <div class=\"input-row\">\n        <label for=\"day-0\">Mon</label>\n        <input id=\"day-0\" type=\"number\" min=\"0\" max=\"12\" step=\"0.5\" value=\"7\" inputmode=\"decimal\" />\n      </div>\n      <div class=\"input-row\">\n        <label for=\"day-1\">Tue</label>\n        <input id=\"day-1\" type=\"number\" min=\"0\" max=\"12\" step=\"0.5\" value=\"8\" inputmode=\"decimal\" />\n      </div>\n      <div class=\"input-row\">\n        <label for=\"day-2\">Wed</label>\n        <input id=\"day-2\" type=\"number\" min=\"0\" max=\"12\" step=\"0.5\" value=\"6.5\" inputmode=\"decimal\" />\n      </div>\n      <div class=\"input-row\">\n        <label for=\"day-3\">Thu</label>\n        <input id=\"day-3\" type=\"number\" min=\"0\" max=\"12\" step=\"0.5\" value=\"9\" inputmode=\"decimal\" />\n      </div>\n      <div class=\"input-row\">\n        <label for=\"day-4\">Fri</label>\n        <input id=\"day-4\" type=\"number\" min=\"0\" max=\"12\" step=\"0.5\" value=\"7.5\" inputmode=\"decimal\" />\n      </div>\n      <div class=\"input-row\">\n        <label for=\"day-5\">Sat</label>\n        <input id=\"day-5\" type=\"number\" min=\"0\" max=\"12\" step=\"0.5\" value=\"10\" inputmode=\"decimal\" />\n      </div>\n      <div class=\"input-row\">\n        <label for=\"day-6\">Sun</label>\n        <input id=\"day-6\" type=\"number\" min=\"0\" max=\"12\" step=\"0.5\" value=\"8.5\" inputmode=\"decimal\" />\n      </div>\n    </form>\n\n    <section class=\"chart-section\" aria-label=\"Weekly sleep bar chart\">\n      <canvas id=\"chart\" width=\"700\" height=\"320\" role=\"img\" aria-label=\"Bar chart of sleep hours per day\"></canvas>\n    </section>\n\n    <section class=\"stats\" aria-live=\"polite\">\n      <p class=\"average\">Weekly average: <strong id=\"average\">7.5</strong> hours</p>\n      <p id=\"longest\" class=\"longest\">Longest night: <strong>Saturday</strong> (10 hours)</p>\n    </section>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
      "description": ""
    },
    {
      "path": "styles.css",
      "content": ":root {\n  --bg: #1e1b2e;\n  --card: #2a2640;\n  --text: #f0edf7;\n  --muted: #b9b2d0;\n  --accent: #8b7cf6;\n  --accent-2: #f6a87c;\n  --bar: #8b7cf6;\n  --bar-highlight: #f6a87c;\n  --focus: #ffd166;\n}\n\n* { box-sizing: border-box; }\n\n[hidden] { display: none !important; }\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--bg);\n  color: var(--text);\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  font-size: 16px;\n  padding: 24px 16px;\n}\n\n.card {\n  background: var(--card);\n  border-radius: 16px;\n  padding: 28px 24px;\n  width: 100%;\n  max-width: 760px;\n  box-shadow: 0 12px 40px rgba(0,0,0,0.35);\n}\n\nh1 {\n  margin: 0 0 4px;\n  font-size: 1.6rem;\n  letter-spacing: 0.5px;\n}\n\n.subtitle {\n  margin: 0 0 20px;\n  color: var(--muted);\n  font-size: 1rem;\n}\n\n.inputs {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));\n  gap: 12px;\n  margin-bottom: 24px;\n}\n\n.input-row {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\nlabel {\n  font-size: 0.95rem;\n  color: var(--muted);\n  font-weight: 600;\n}\n\ninput[type=\"number\"] {\n  width: 100%;\n  padding: 10px 12px;\n  border-radius: 10px;\n  border: 2px solid transparent;\n  background: #3a3556;\n  color: var(--text);\n  font-size: 1rem;\n  font-family: inherit;\n  transition: border-color 0.15s, background 0.15s;\n}\n\ninput[type=\"number\"]:hover {\n  background: #443e66;\n}\n\ninput[type=\"number\"]:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n  border-color: var(--accent);\n}\n\ninput[type=\"number\"]:active {\n  background: #4d4673;\n}\n\n.chart-section {\n  background: #221f36;\n  border-radius: 12px;\n  padding: 12px;\n  margin-bottom: 20px;\n}\n\ncanvas {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n\n.stats {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px 24px;\n  align-items: baseline;\n}\n\n.stats p {\n  margin: 0;\n  font-size: 1.05rem;\n}\n\n.average strong {\n  color: var(--accent-2);\n  font-size: 1.25rem;\n}\n\n.longest strong {\n  color: var(--accent-2);\n}\n\n@media (max-width: 480px) {\n  .card { padding: 20px 16px; }\n  h1 { font-size: 1.4rem; }\n  .inputs { grid-template-columns: repeat(auto-fit, minmax(70px, 1fr)); gap: 8px; }\n  input[type=\"number\"] { padding: 8px; font-size: 0.95rem; }\n}",
      "description": ""
    },
    {
      "path": "script.js",
      "content": "const DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];\nconst MAX_HOURS = 12;\nconst canvas = document.getElementById('chart');\nconst ctx = canvas.getContext('2d');\nconst averageEl = document.getElementById('average');\nconst longestEl = document.getElementById('longest');\nconst inputs = DAYS.map((_, i) => document.getElementById(`day-${i}`));\n\nfunction getValues() {\n  return inputs.map((input) => {\n    let v = parseFloat(input.value);\n    if (isNaN(v)) v = 0;\n    return Math.min(MAX_HOURS, Math.max(0, v));\n  });\n}\n\nfunction drawChart(values) {\n  const w = canvas.width;\n  const h = canvas.height;\n  ctx.clearRect(0, 0, w, h);\n\n  const padding = 40;\n  const chartW = w - padding * 2;\n  const chartH = h - padding * 2;\n  const barGap = 12;\n  const barW = (chartW - barGap * (DAYS.length - 1)) / DAYS.length;\n  const maxVal = Math.max(...values, 1);\n  const maxIndex = values.indexOf(Math.max(...values));\n\n  ctx.font = '14px system-ui, sans-serif';\n  ctx.textAlign = 'center';\n\n  // baseline\n  ctx.strokeStyle = '#4d4673';\n  ctx.lineWidth = 1;\n  ctx.beginPath();\n  ctx.moveTo(padding, padding + chartH);\n  ctx.lineTo(padding + chartW, padding + chartH);\n  ctx.stroke();\n\n  values.forEach((val, i) => {\n    const barH = (val / maxVal) * chartH;\n    const x = padding + i * (barW + barGap);\n    const y = padding + chartH - barH;\n    const isLongest = i === maxIndex && val > 0;\n\n    ctx.fillStyle = isLongest ? '#f6a87c' : '#8b7cf6';\n    ctx.fillRect(x, y, barW, barH);\n\n    // value label\n    ctx.fillStyle = '#f0edf7';\n    ctx.fillText(val % 1 === 0 ? val : val.toFixed(1), x + barW / 2, y - 8);\n\n    // day label\n    ctx.fillStyle = '#b9b2d0';\n    ctx.fillText(DAYS[i], x + barW / 2, padding + chartH + 22);\n  });\n}\n\nfunction update() {\n  const values = getValues();\n  drawChart(values);\n\n  const sum = values.reduce((a, b) => a + b, 0);\n  const avg = sum / values.length;\n  averageEl.textContent = avg.toFixed(1);\n\n  const maxVal = Math.max(...values);\n  const maxIndex = values.indexOf(maxVal);\n  if (maxVal > 0) {\n    longestEl.innerHTML = `Longest night: <strong>${DAYS[maxIndex]}</strong> (${maxVal % 1 === 0 ? maxVal : maxVal.toFixed(1)} hours)`;\n  } else {\n    longestEl.textContent = 'No sleep recorded.';\n  }\n}\n\ninputs.forEach((input) => {\n  input.addEventListener('input', update);\n  input.addEventListener('change', update);\n});\n\nupdate();",
      "description": ""
    },
    {
      "path": "README.md",
      "content": "# Pixel Sleep Bar Chart\n\nAn offline browser app to track and visualize 7 days of sleep hours.\n\n## Features\n\n- 7 number inputs (0–12 hours) with keyboard-accessible labels.\n- Pixel-style bar chart drawn on canvas; bar heights scale to values.\n- Weekly average displayed to one decimal place.\n- Longest night highlighted in a contrasting color and named in text.\n- Responsive layout down to 360px wide.\n- Cohesive dark palette with visible hover, focus, and pressed states.\n\n## Usage\n\n1. Open `index.html` in any modern browser.\n2. Adjust the hours slept for each day.\n3. The chart, average, and longest-night highlight update instantly.\n\n## Files\n\n- `index.html` – structure and controls\n- `styles.css` – theme, layout, and states\n- `script.js` – chart rendering and calculations\n- `README.md` – this file\n\nNo external assets, packages, or network requests are used.",
      "description": ""
    }
  ]
}