      "path": "style.css",
      "content": ":root {\n  --bg: #1e1e2f;\n  --card-bg: #2d2d44;\n  --text: #f0f0f0;\n  --accent: #6c63ff;\n  --accent-hover: #5a52d5;\n  --danger: #ff4d4d;\n  --success: #4caf50;\n  --key-bg: #3a3a5a;\n  --key-hover: #4a4a6a;\n  --key-active: #2a2a4a;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  background: var(--bg);\n  font-family: system-ui, -apple-system, sans-serif;\n  font-size: 18px;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 1rem;\n  color: var(--text);\n}\n\n.card {\n  background: var(--card-bg);\n  border-radius: 1.5rem;\n  padding: 2rem;\n  width: 100%;\n  max-width: 400px;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1.5rem;\n}\n\nh1 {\n  font-size: 1.8rem;\n  font-weight: 600;\n  text-align: center;\n  color: var(--accent);\n}\n\n.display {\n  background: #0f0f1a;\n  color: #fff;\n  font-size: 1.5rem;\n  padding: 1rem;\n  border-radius: 0.75rem;\n  width: 100%;\n  text-align: center;\n  min-height: 3.5rem;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 2px solid #3a3a5a;\n  transition: border-color 0.2s;\n  word-break: break-word;\n}\n\n.display.success {\n  border-color: var(--success);\n  color: var(--success);\n}\n\n.display.error {\n  border-color: var(--danger);\n  color: var(--danger);\n}\n\n.keypad {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 0.75rem;\n  width: 100%;\n}\n\n.key {\n  background: var(--key-bg);\n  color: var(--text);\n  border: none;\n  border-radius: 0.75rem;\n  font-size: 1.5rem;\n  font-weight: 600;\n  padding: 1rem 0;\n  cursor: pointer;\n  transition: background 0.15s, transform 0.1s;\n  user-select: none;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.key:hover {\n  background: var(--key-hover);\n}\n\n.key:focus-visible {\n  outline: 3px solid var(--accent);\n  outline-offset: 2px;\n}\n\n.key:active {\n  background: var(--key-active);\n  transform: scale(0.96);\n}\n\n.key.clear {\n  background: var(--danger);\n  color: #fff;\n}\n\n.key.clear:hover {\n  background: #e04343;\n}\n\n.key.clear:active {\n  background: #c0392b;\n}\n\n.key.enter {\n  background: var(--accent);\n  color: #fff;\n}\n\n.key.enter:hover {\n  background: var(--accent-hover);\n}\n\n.key.enter:active {\n  background: #4a42b5;\n}\n\n.attempts {\n  font-size: 1rem;\n  color: #aaa;\n  text-align: center;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n@media (max-width: 400px) {\n  .card {\n    padding: 1.5rem;\n  }\n  h1 {\n    font-size: 1.5rem;\n  }\n  .key {\n    font-size: 1.25rem;\n    padding: 0.75rem 0;\n  }\n}",
      "description": "CSS styles for the keypad lock app"
    },
    {
      "path": "script.js",
      "content": "const CODE = '4271';\nconst MAX_ATTEMPTS = 3;\nconst LOCK_DURATION = 10000; // 10 seconds\n\nconst display = document.getElementById('display');\nconst attemptsEl = document.getElementById('attempts');\nconst keypad = document.querySelector('.keypad');\n\nlet currentInput = '';\nlet attemptsLeft = MAX_ATTEMPTS;\nlet locked = false;\nlet lockTimeout = null;\n\nfunction updateDisplay(message, type = '') {\n  display.textContent = message;\n  display.className = 'display' + (type ? ' ' + type : '');\n}\n\nfunction updateAttempts() {\n  attemptsEl.textContent = `Attempts left: ${attemptsLeft}`;\n}\n\nfunction resetInput() {\n  currentInput = '';\n}\n\nfunction lockKeypad() {\n  locked = true;\n  keypad.querySelectorAll('.key').forEach(btn => btn.disabled = true);\n  updateDisplay(`Locked for 10s`, 'error');\n  lockTimeout = setTimeout(() => {\n    locked = false;\n    keypad.querySelectorAll('.key').forEach(btn => btn.disabled = false);\n    attemptsLeft = MAX_ATTEMPTS;\n    updateAttempts();\n    updateDisplay('Enter code');\n    resetInput();\n  }, LOCK_DURATION);\n}\n\nfunction handleDigit(digit) {\n  if (locked) return;\n  if (currentInput.length < 4) {\n    currentInput += digit;\n    updateDisplay(currentInput);\n  }\n}\n\nfunction handleEnter() {\n  if (locked) return;\n  if (currentInput === CODE) {\n    updateDisplay('Unlocked', 'success');\n    resetInput();\n  } else {\n    attemptsLeft--;\n    updateAttempts();\n    if (attemptsLeft <= 0) {\n      lockKeypad();\n    } else {\n      updateDisplay('Wrong code', 'error');\n      resetInput();\n      setTimeout(() => {\n        if (!locked) updateDisplay('Enter code');\n      }, 1500);\n    }\n  }\n}\n\nfunction handleClear() {\n  if (locked) return;\n  resetInput();\n  updateDisplay('Enter code');\n}\n\n// Event listeners\nkeypad.addEventListener('click', (e) => {\n  const btn = e.target.closest('button');\n  if (!btn || btn.disabled) return;\n  if (btn.dataset.digit) {\n    handleDigit(btn.dataset.digit);\n  } else if (btn.id === 'clear') {\n    handleClear();\n  } else if (btn.id === 'enter') {\n    handleEnter();\n  }\n});\n\n// Keyboard support\ndocument.addEventListener('keydown', (e) => {\n  if (locked) return;\n  if (e.key >= '0' && e.key <= '9') {\n    handleDigit(e.key);\n    e.preventDefault();\n  } else if (e.key === 'Enter') {\n    handleEnter();\n    e.preventDefault();\n  } else if (e.key === 'Escape' || e.key === 'Delete') {\n    handleClear();\n    e.preventDefault();\n  }\n});\n\n// Initial state\nupdateAttempts();",
      "description": "JavaScript logic for the keypad lock"
    },
    {
      "path": "README.md",
      "content": "# Pixel Keypad Lock\n\nA simple offline browser app that simulates a keypad lock with a secret code.\n\n## Features\n\n- Enter digits 0-9 using on-screen buttons or keyboard.\n- Clear button to reset input.\n- Enter button to submit code.\n- Correct code (4271) shows \"Unlocked\".\n- Wrong code shows \"Wrong code\" and decrements attempts.\n- After 3 wrong attempts, keypad locks for 10 seconds.\n- Fully keyboard accessible with focus indicators.\n- Responsive layout works from 360px wide.\n\n## Usage\n\nOpen `index.html` in any modern browser. No server or network required.\n\n## Code\n\nThe secret code is `4271`. You can change it by editing the `CODE` constant in `script.js`.\n\n## Files\n\n- `index.html` – structure\n- `style.css` – styling\n- `script.js` – logic",
      "description": "README documentation"
    }
  ]
}