      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Loan Calculator</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Pixel Loan Calculator</h1>\n    <form id=\"loan-form\">\n      <div class=\"field\">\n        <label for=\"amount\">Loan amount ($)</label>\n        <input type=\"number\" id=\"amount\" min=\"0\" step=\"any\" placeholder=\"e.g. 10000\" required>\n      </div>\n      <div class=\"field\">\n        <label for=\"rate\">Yearly interest rate (%)</label>\n        <input type=\"number\" id=\"rate\" min=\"0\" step=\"any\" placeholder=\"e.g. 5\" required>\n      </div>\n      <div class=\"field\">\n        <label for=\"years\">Loan term (years)</label>\n        <input type=\"number\" id=\"years\" min=\"0\" step=\"any\" placeholder=\"e.g. 3\" required>\n      </div>\n      <button type=\"submit\" id=\"calc-btn\">Calculate</button>\n    </form>\n    <div class=\"results\" id=\"results\" aria-live=\"polite\">\n      <div class=\"result-row\">\n        <span class=\"label\">Monthly payment:</span>\n        <span class=\"value\" id=\"monthly\">—</span>\n      </div>\n      <div class=\"result-row\">\n        <span class=\"label\">Total paid:</span>\n        <span class=\"value\" id=\"total-paid\">—</span>\n      </div>\n      <div class=\"result-row\">\n        <span class=\"label\">Total interest:</span>\n        <span class=\"value\" id=\"total-interest\">—</span>\n      </div>\n    </div>\n    <p class=\"error\" id=\"error-msg\" role=\"alert\"></p>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
