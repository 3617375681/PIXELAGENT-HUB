      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Maze Escape</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Pixel Maze Escape</h1>\n    <p class=\"instructions\">Use arrow keys to move. Reach the exit (★) to escape!</p>\n    <div class=\"status-bar\">\n      <span id=\"step-counter\" aria-live=\"polite\">Steps: 0</span>\n      <span id=\"message\" role=\"status\" aria-live=\"assertive\" hidden>You escaped!</span>\n    </div>\n    <div id=\"maze\" class=\"maze\" role=\"grid\" aria-label=\"7 by 7 maze grid\"></div>\n    <button id=\"restart-btn\" type=\"button\" aria-label=\"Restart game\">Restart</button>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
      "description": "Main HTML page with game board, status bar, message, and restart button."
