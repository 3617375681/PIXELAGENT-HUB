  "files": [
    {
      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Currency Converter</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Pixel Currency Converter</h1>\n    <div class=\"converter\">\n      <div class=\"field\">\n        <label for=\"amount\">Amount</label>\n        <input type=\"number\" id=\"amount\" value=\"1\" step=\"0.01\" min=\"0\" inputmode=\"decimal\">\n      </div>\n      <div class=\"field\">\n        <label for=\"from\">From</label>\n        <select id=\"from\">\n          <option value=\"USD\">USD</option>\n          <option value=\"EUR\">EUR</option>\n          <option value=\"JPY\">JPY</option>\n          <option value=\"CNY\">CNY</option>\n        </select>\n      </div>\n      <button id=\"swap\" type=\"button\" aria-label=\"Swap currencies\">⇄</button>\n      <div class=\"field\">\n        <label for=\"to\">To</label>\n        <select id=\"to\">\n          <option value=\"EUR\">EUR</option>\n          <option value=\"USD\">USD</option>\n          <option value=\"JPY\">JPY</option>\n          <option value=\"CNY\">CNY</option>\n        </select>\n      </div>\n      <div class=\"result\" id=\"result\" aria-live=\"polite\">0.00</div>\n    </div>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
      "description": ""
    },
    {
      "path": "styles.css",
      "content": ":root {\n  --bg: #1a1a2e;\n  --card-bg: #16213e;\n  --accent: #e94560;\n  --text: #eaeaea;\n  --input-bg: #0f3460;\n  --border: #533483;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  background: var(--bg);\n  color: var(--text);\n  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  font-size: 16px;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n}\n\n.card {\n  background: var(--card-bg);\n  border: 4px solid var(--border);\n  border-radius: 8px;\n  padding: 24px;\n  width: 100%;\n  max-width: 420px;\n  box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.4);\n}\n\nh1 {\n  font-size: 1.5rem;\n  text-align: center;\n  margin-bottom: 24px;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n\n.converter {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\nlabel {\n  font-size: 0.9rem;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  color: var(--text);\n  opacity: 0.8;\n}\n\ninput, select, button {\n  font-family: inherit;\n  font-size: 1rem;\n  padding: 12px;\n  background: var(--input-bg);\n  color: var(--text);\n  border: 3px solid var(--border);\n  border-radius: 4px;\n  outline: none;\n  transition: border-color 0.15s, box-shadow 0.15s;\n}\n\ninput:focus, select:focus, button:focus {\n  border-color: var(--accent);\n  box-shadow: 0 0 0 3px rgba(233, 69, 96, 0.4);\n}\n\ninput:hover, select:hover {\n  border-color: var(--accent);\n}\n\nbutton {\n  cursor: pointer;\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #fff;\n  font-weight: bold;\n  text-align: center;\n  letter-spacing: 2px;\n  padding: 10px;\n}\n\nbutton:hover {\n  filter: brightness(1.1);\n}\n\nbutton:active {\n  transform: translate(2px, 2px);\n  box-shadow: none;\n}\n\n#swap {\n  align-self: center;\n  width: 60px;\n  height: 48px;\n  font-size: 1.4rem;\n  line-height: 1;\n}\n\n.result {\n  background: var(--input-bg);\n  border: 3px solid var(--border);\n  border-radius: 4px;\n  padding: 16px;\n  font-size: 1.8rem;\n  font-weight: bold;\n  text-align: center;\n  letter-spacing: 1px;\n  word-break: break-all;\n  color: var(--accent);\n}\n\n@media (max-width: 400px) {\n  .card {\n    padding: 16px;\n  }\n  h1 {\n    font-size: 1.25rem;\n  }\n  .result {\n    font-size: 1.4rem;\n  }\n}",
      "description": ""
    },
    {
      "path": "script.js",
      "content": "const RATES = {\n  USD: { USD: 1, EUR: 0.92, JPY: 150.0, CNY: 7.2 },\n  EUR: { USD: 1.09, EUR: 1, JPY: 163.0, CNY: 7.8 },\n  JPY: { USD: 0.0067, EUR: 0.0061, JPY: 1, CNY: 0.048 },\n  CNY: { USD: 0.14, EUR: 0.13, JPY: 20.8, CNY: 1 }\n};\n\nconst amountInput = document.getElementById('amount');\nconst fromSelect = document.getElementById('from');\nconst toSelect = document.getElementById('to');\nconst swapButton = document.getElementById('swap');\nconst resultDiv = document.getElementById('result');\n\nfunction convert() {\n  const amount = parseFloat(amountInput.value);\n  if (isNaN(amount) || amount < 0) {\n    resultDiv.textContent = '0.00';\n    return;\n  }\n  const from = fromSelect.value;\n  const to = toSelect.value;\n  const rate = RATES[from][to];\n  const converted = amount * rate;\n  resultDiv.textContent = converted.toFixed(2);\n}\n\nfunction swapCurrencies() {\n  const temp = fromSelect.value;\n  fromSelect.value = toSelect.value;\n  toSelect.value = temp;\n  convert();\n}\n\namountInput.addEventListener('input', convert);\nfromSelect.addEventListener('change', convert);\ntoSelect.addEventListener('change', convert);\nswapButton.addEventListener('click', swapCurrencies);\n\nconvert();",
      "description": ""
    },
