      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Calculator</title>\n  <style>\n    :root {\n      --bg: #1a1a2e;\n      --card: #16213e;\n      --accent: #e94560;\n      --text: #eaeaea;\n      --input-bg: #0f3460;\n    }\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      background: var(--bg);\n      color: var(--text);\n      font-family: system-ui, -apple-system, sans-serif;\n      font-size: 16px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100vh;\n      padding: 1rem;\n    }\n    .card {\n      background: var(--card);\n      padding: 2rem;\n      border-radius: 12px;\n      box-shadow: 0 8px 0 rgba(0,0,0,0.3);\n      width: 100%;\n      max-width: 400px;\n    }\n    h1 {\n      font-size: 1.5rem;\n      margin-bottom: 1.5rem;\n      text-align: center;\n      letter-spacing: 1px;\n    }\n    label {\n      display: block;\n      margin-bottom: 0.25rem;\n      font-size: 0.9rem;\n      color: #a0a0b0;\n    }\n    input, select, button {\n      width: 100%;\n      padding: 0.75rem;\n      font-size: 1rem;\n      border: 2px solid var(--input-bg);\n      border-radius: 6px;\n      background: var(--input-bg);\n      color: var(--text);\n      font-family: inherit;\n      transition: border-color 0.2s, background 0.2s;\n    }\n    input:focus, select:focus, button:focus {\n      outline: none;\n      border-color: var(--accent);\n      background: #1a4a7a;\n    }\n    input:hover, select:hover {\n      border-color: var(--accent);\n    }\n    button {\n      background: var(--accent);\n      border-color: var(--accent);\n      color: #fff;\n      font-weight: bold;\n      cursor: pointer;\n      margin-top: 1rem;\n    }\n    button:hover {\n      background: #f05a75;\n      border-color: #f05a75;\n    }\n    button:active {\n      transform: translateY(2px);\n      box-shadow: none;\n    }\n    .result {\n      margin-top: 1.5rem;\n      padding: 1rem;\n      background: var(--input-bg);\n      border-radius: 6px;\n      text-align: center;\n      font-size: 1.5rem;\n      font-weight: bold;\n      min-height: 3.5rem;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      word-break: break-all;\n    }\n    .field { margin-bottom: 1rem; }\n    @media (max-width: 400px) {\n      .card { padding: 1.5rem; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"card\">\n    <h1>PIXEL CALC</h1>\n    <div class=\"field\">\n      <label for=\"left\">Left number</label>\n      <input id=\"left\" type=\"text\" inputmode=\"decimal\" placeholder=\"e.g. -5\" />\n    </div>\n    <div class=\"field\">\n      <label for=\"right\">Right number</label>\n      <input id=\"right\" type=\"text\" inputmode=\"decimal\" placeholder=\"e.g. 3\" />\n    </div>\n    <div class=\"field\">\n      <label for=\"operation\">Operation</label>\n      <select id=\"operation\">\n        <option value=\"add\">Add (+)</option>\n        <option value=\"subtract\">Subtract (−)</option>\n        <option value=\"multiply\">Multiply (×)</option>\n        <option value=\"divide\">Divide (÷)</option>\n      </select>\n    </div>\n    <button id=\"calculate\" type=\"button\">Calculate</button>\n    <output id=\"result\" class=\"result\" aria-live=\"polite\">0</output>\n  </main>\n  <script>\n    (function () {\n      const left = document.getElementById('left');\n      const right = document.getElementById('right');\n      const operation = document.getElementById('operation');\n      const calculate = document.getElementById('calculate');\n      const result = document.getElementById('result');\n\n      function compute() {\n        const aStr = left.value.trim();\n        const bStr = right.value.trim();\n        const a = Number(aStr);\n        const b = Number(bStr);\n\n        if (aStr === '' || bStr === '' || !isFinite(a) || !isFinite(b)) {\n          result.textContent = 'Error';\n          return;\n        }\n\n        let value;\n        switch (operation.value) {\n          case 'add': value = a + b; break;\n          case 'subtract': value = a - b; break;\n          case 'multiply': value = a * b; break;\n          case 'divide':\n            if (b === 0) {\n              result.textContent = 'Error';\n              return;\n            }\n            value = a / b;\n            break;\n          default:\n            result.textContent = 'Error';\n            return;\n        }\n\n        if (!isFinite(value)) {\n          result.textContent = 'Error';\n          return;\n        }\n        result.textContent = String(value);\n      }\n\n      calculate.addEventListener('click', compute);\n      [left, right].forEach(function (el) {\n        el.addEventListener('keydown', function (e) {\n          if (e.key === 'Enter') compute();\n        });\n      });\n    })();\n  </script>\n</body>\n</html>",
      "description": ""
