      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Metronome</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"metronome-card\">\n    <h1>Pixel Metronome</h1>\n    <div class=\"bpm-controls\">\n      <button id=\"bpm-down\" class=\"btn\" aria-label=\"Decrease BPM\">−</button>\n      <div class=\"bpm-display\" aria-live=\"polite\">\n        <span id=\"bpm-value\">120</span> <span class=\"unit\">BPM</span>\n      </div>\n      <button id=\"bpm-up\" class=\"btn\" aria-label=\"Increase BPM\">+</button>\n    </div>\n    <div class=\"transport\">\n      <button id=\"start-stop\" class=\"btn primary\" aria-label=\"Start metronome\">Start</button>\n    </div>\n    <div class=\"beat-section\">\n      <div id=\"beat-light\" class=\"beat-light\" aria-hidden=\"true\"></div>\n      <div class=\"beat-counter\" aria-live=\"polite\">\n        Beat: <span id=\"beat-count\">0</span>\n      </div>\n    </div>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
      "description": "Main HTML file with metronome UI"
