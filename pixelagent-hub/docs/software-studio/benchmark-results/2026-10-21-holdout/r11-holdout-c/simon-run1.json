      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Simon</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <main class=\"game-container\">\n    <div class=\"card\">\n      <h1>Pixel Simon</h1>\n      <div class=\"status-bar\">\n        <span id=\"level-display\" class=\"level\">Level: 0</span>\n        <span id=\"message\" class=\"message\" role=\"status\" aria-live=\"polite\"></span>\n      </div>\n      <div class=\"board\" role=\"group\" aria-label=\"Simon game pads\">\n        <button class=\"pad green\" data-color=\"green\" aria-label=\"Green pad\"></button>\n        <button class=\"pad red\" data-color=\"red\" aria-label=\"Red pad\"></button>\n        <button class=\"pad yellow\" data-color=\"yellow\" aria-label=\"Yellow pad\"></button>\n        <button class=\"pad blue\" data-color=\"blue\" aria-label=\"Blue pad\"></button>\n      </div>\n      <div class=\"controls\">\n        <button id=\"restart-btn\" class=\"restart-btn\" hidden>Restart</button>\n      </div>\n    </div>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
