    {
      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Metronome</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"metronome\" aria-label=\"Pixel Metronome\">\n    <h1>Pixel Metronome</h1>\n    <div class=\"bpm-section\">\n      <button id=\"bpm-down\" class=\"btn\" aria-label=\"Decrease BPM\">−</button>\n      <div class=\"bpm-display\" aria-live=\"polite\">\n        <span id=\"bpm-value\">120</span> <span class=\"bpm-label\">BPM</span>\n      </div>\n      <button id=\"bpm-up\" class=\"btn\" aria-label=\"Increase BPM\">+</button>\n    </div>\n    <div class=\"controls\">\n      <button id=\"start-btn\" class=\"btn primary\" aria-label=\"Start metronome\">Start</button>\n      <button id=\"stop-btn\" class=\"btn\" aria-label=\"Stop metronome\" disabled>Stop</button>\n    </div>\n    <div class=\"beat-section\">\n      <div id=\"beat-light\" class=\"beat-light\" role=\"img\" aria-label=\"Beat indicator\"></div>\n      <div class=\"beat-counter\" aria-live=\"polite\">\n        Beats: <span id=\"beat-count\">0</span>\n      </div>\n    </div>\n    <p class=\"warning\" role=\"note\">⚠️ Flashing light may affect photosensitive users. Max 3.3 Hz.</p>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
      "description": ""
    },
    {
      "path": "style.css",
      "content": ":root {\n  --bg: #1a1a2e;\n  --card: #16213e;\n  --accent: #e94560;\n  --text: #eaeaea;\n  --btn: #0f3460;\n  --btn-hover: #1a4a7a;\n  --btn-active: #0a2647;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  background: var(--bg);\n  color: var(--text);\n  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  font-size: 16px;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n}\n\n.metronome {\n  background: var(--card);\n  border: 4px solid var(--accent);\n  border-radius: 12px;\n  padding: 24px;\n  width: 100%;\n  max-width: 400px;\n  text-align: center;\n  box-shadow: 0 8px 0 rgba(0,0,0,0.3);\n}\n\nh1 {\n  font-size: 1.5rem;\n  margin-bottom: 24px;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n\n.bpm-section {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n  margin-bottom: 24px;\n}\n\n.bpm-display {\n  font-size: 2rem;\n  font-weight: bold;\n  min-width: 100px;\n  font-variant-numeric: tabular-nums;\n}\n\n.bpm-label {\n  font-size: 1rem;\n  font-weight: normal;\n  color: #aaa;\n}\n\n.btn {\n  background: var(--btn);\n  color: var(--text);\n  border: 2px solid var(--accent);\n  border-radius: 8px;\n  padding: 12px 20px;\n  font-size: 1.25rem;\n  font-weight: bold;\n  cursor: pointer;\n  transition: background 0.1s, transform 0.05s;\n  min-width: 48px;\n  min-height: 48px;\n}\n\n.btn:hover:not(:disabled) {\n  background: var(--btn-hover);\n}\n\n.btn:focus-visible {\n  outline: 3px solid var(--accent);\n  outline-offset: 2px;\n}\n\n.btn:active:not(:disabled) {\n  background: var(--btn-active);\n  transform: scale(0.96);\n}\n\n.btn:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.btn.primary {\n  background: var(--accent);\n  color: var(--bg);\n  border-color: var(--accent);\n}\n\n.btn.primary:hover:not(:disabled) {\n  background: #ff6b81;\n}\n\n.controls {\n  display: flex;\n  gap: 12px;\n  justify-content: center;\n  margin-bottom: 24px;\n  flex-wrap: wrap;\n}\n\n.beat-section {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n}\n\n.beat-light {\n  width: 60px;\n  height: 60px;\n  border-radius: 50%;\n  background: #333;\n  border: 4px solid #555;\n  transition: background 0.05s, box-shadow 0.05s;\n}\n\n.beat-light.active {\n  background: var(--accent);\n  box-shadow: 0 0 20px var(--accent), 0 0 40px var(--accent);\n  border-color: #ff8fa3;\n}\n\n.beat-counter {\n  font-size: 1.25rem;\n  font-variant-numeric: tabular-nums;\n}\n\n.warning {\n  margin-top: 20px;\n  font-size: 0.75rem;\n  color: #888;\n  line-height: 1.4;\n}\n\n@media (max-width: 400px) {\n  .metronome {\n    padding: 16px;\n  }\n  .bpm-display {\n    font-size: 1.5rem;\n    min-width: 80px;\n  }\n  .btn {\n    padding: 10px 16px;\n    font-size: 1rem;\n  }\n}",
      "description": ""
    },
    {
      "path": "script.js",
      "content": "const bpmValue = document.getElementById('bpm-value');\nconst bpmDown = document.getElementById('bpm-down');\nconst bpmUp = document.getElementById('bpm-up');\nconst startBtn = document.getElementById('start-btn');\nconst stopBtn = document.getElementById('stop-btn');\nconst beatLight = document.getElementById('beat-light');\nconst beatCount = document.getElementById('beat-count');\n\nlet bpm = 120;\nlet isRunning = false;\nlet timerId = null;\nlet beats = 0;\nlet nextBeatTime = 0;\nlet flashTimeout = null;\n\nconst MIN_BPM = 40;\nconst MAX_BPM = 200;\n\nfunction updateBpmDisplay() {\n  bpmValue.textContent = bpm;\n  bpmDown.disabled = bpm <= MIN_BPM;\n  bpmUp.disabled = bpm >= MAX_BPM;\n}\n\nfunction setBpm(newBpm) {\n  bpm = Math.min(MAX_BPM, Math.max(MIN_BPM, newBpm));\n  updateBpmDisplay();\n  if (isRunning) {\n    stop();\n    start();\n  }\n}\n\nfunction flashLight() {\n  beatLight.classList.add('active');\n  if (flashTimeout) clearTimeout(flashTimeout);\n  flashTimeout = setTimeout(() => {\n    beatLight.classList.remove('active');\n  }, 100);\n}\n\nfunction tick() {\n  beats++;\n  beatCount.textContent = beats;\n  flashLight();\n}\n\nfunction scheduleNext() {\n  if (!isRunning) return;\n  const interval = 60000 / bpm;\n  nextBeatTime += interval;\n  const delay = Math.max(0, nextBeatTime - performance.now());\n  timerId = setTimeout(() => {\n    tick();\n    scheduleNext();\n  }, delay);\n}\n\nfunction start() {\n  if (isRunning) return;\n  isRunning = true;\n  beats = 0;\n  beatCount.textContent = '0';\n  startBtn.disabled = true;\n  stopBtn.disabled = false;\n  nextBeatTime = performance.now();\n  tick();\n  scheduleNext();\n}\n\nfunction stop() {\n  if (!isRunning) return;\n  isRunning = false;\n  if (timerId) {\n    clearTimeout(timerId);\n    timerId = null;\n  }\n  if (flashTimeout) {\n    clearTimeout(flashTimeout);\n    flashTimeout = null;\n  }\n  beatLight.classList.remove('active');\n  startBtn.disabled = false;\n  stopBtn.disabled = true;\n}\n\nbpmDown.addEventListener('click', () => setBpm(bpm - 1));\nbpmUp.addEventListener('click', () => setBpm(bpm + 1));\nstartBtn.addEventListener('click', start);\nstopBtn.addEventListener('click', stop);\n\nupdateBpmDisplay();",
      "description": ""
