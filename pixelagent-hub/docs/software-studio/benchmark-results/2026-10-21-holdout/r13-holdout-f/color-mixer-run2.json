  "files": [
    {
      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Pixel RGB Color Mixer</title>\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Pixel RGB Color Mixer</h1>\n    <div id=\"preview\" class=\"preview\" aria-live=\"polite\" aria-label=\"Color preview\"></div>\n    <output id=\"hex\" class=\"hex\" aria-live=\"polite\">#000000</output>\n    <div class=\"controls\">\n      <div class=\"slider-group\">\n        <label for=\"red\">Red</label>\n        <input type=\"range\" id=\"red\" min=\"0\" max=\"255\" value=\"0\" step=\"1\" />\n        <output id=\"red-value\" class=\"value\" for=\"red\">0</output>\n      </div>\n      <div class=\"slider-group\">\n        <label for=\"green\">Green</label>\n        <input type=\"range\" id=\"green\" min=\"0\" max=\"255\" value=\"0\" step=\"1\" />\n        <output id=\"green-value\" class=\"value\" for=\"green\">0</output>\n      </div>\n      <div class=\"slider-group\">\n        <label for=\"blue\">Blue</label>\n        <input type=\"range\" id=\"blue\" min=\"0\" max=\"255\" value=\"0\" step=\"1\" />\n        <output id=\"blue-value\" class=\"value\" for=\"blue\">0</output>\n      </div>\n    </div>\n    <button id=\"random\" type=\"button\" class=\"btn\">Random</button>\n  </main>\n  <script src=\"app.js\"></script>\n</body>\n</html>",
      "description": "Markup and structure, unchanged."
    },
    {
      "path": "styles.css",
      "content": "[hidden] { display: none !important; }\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #1e1e2f;\n  color: #f0f0f5;\n  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  font-size: 16px;\n  padding: 16px;\n}\n\n.card {\n  background: #2a2a40;\n  border-radius: 16px;\n  padding: 32px;\n  width: 100%;\n  max-width: 480px;\n  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\nh1 {\n  margin: 0;\n  font-size: 1.5rem;\n  font-weight: 700;\n  text-align: center;\n  color: #ffffff;\n}\n\n.preview {\n  width: 100%;\n  height: 160px;\n  border-radius: 12px;\n  background: #000000;\n  border: 2px solid #3a3a55;\n  transition: background 0.15s ease;\n}\n\n.hex {\n  text-align: center;\n  font-size: 1.5rem;\n  font-weight: 600;\n  font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', monospace;\n  letter-spacing: 1px;\n  color: #ffffff;\n  background: #1e1e2f;\n  padding: 8px 16px;\n  border-radius: 8px;\n  border: 1px solid #3a3a55;\n}\n\n.controls {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.slider-group {\n  display: grid;\n  grid-template-columns: 60px 1fr 48px;\n  align-items: center;\n  gap: 12px;\n}\n\n.slider-group label {\n  font-weight: 600;\n  font-size: 1rem;\n  color: #c8c8dc;\n}\n\n.slider-group .value {\n  text-align: right;\n  font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', monospace;\n  font-size: 1rem;\n  color: #ffffff;\n  background: #1e1e2f;\n  padding: 4px 8px;\n  border-radius: 6px;\n  border: 1px solid #3a3a55;\n}\n\ninput[type=\"range\"] {\n  -webkit-appearance: none;\n  appearance: none;\n  width: 100%;\n  height: 8px;\n  border-radius: 4px;\n  background: #3a3a55;\n  outline: none;\n  cursor: pointer;\n}\n\ninput[type=\"range\"]::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  appearance: none;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: #7c6cff;\n  border: 2px solid #ffffff;\n  cursor: pointer;\n  transition: transform 0.1s ease, background 0.1s ease;\n}\n\ninput[type=\"range\"]::-moz-range-thumb {\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: #7c6cff;\n  border: 2px solid #ffffff;\n  cursor: pointer;\n  transition: transform 0.1s ease, background 0.1s ease;\n}\n\ninput[type=\"range\"]:hover::-webkit-slider-thumb { background: #9a8dff; }\ninput[type=\"range\"]:hover::-moz-range-thumb { background: #9a8dff; }\n\ninput[type=\"range\"]:active::-webkit-slider-thumb { transform: scale(1.15); background: #5a4cdb; }\ninput[type=\"range\"]:active::-moz-range-thumb { transform: scale(1.15); background: #5a4cdb; }\n\ninput[type=\"range\"]:focus-visible {\n  outline: 3px solid #7c6cff;\n  outline-offset: 4px;\n}\n\n.btn {\n  align-self: center;\n  padding: 12px 32px;\n  font-size: 1.125rem;\n  font-weight: 600;\n  font-family: inherit;\n  color: #ffffff;\n  background: #7c6cff;\n  border: none;\n  border-radius: 10px;\n  cursor: pointer;\n  transition: background 0.15s ease, transform 0.1s ease;\n}\n\n.btn:hover { background: #9a8dff; }\n.btn:focus-visible { outline: 3px solid #ffffff; outline-offset: 3px; }\n.btn:active { background: #5a4cdb; transform: scale(0.97); }\n\n@media (max-width: 400px) {\n  .card { padding: 20px; }\n  .slider-group { grid-template-columns: 48px 1fr 44px; gap: 8px; }\n  h1 { font-size: 1.25rem; }\n  .preview { height: 120px; }\n  .hex { font-size: 1.25rem; }\n}",
      "description": "Visual design and responsive layout, unchanged."
