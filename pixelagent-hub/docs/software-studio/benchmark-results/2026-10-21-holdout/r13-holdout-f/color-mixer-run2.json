      "content": "(function () {\n  'use strict';\n\n  const redInput = document.getElementById('red');\n  const greenInput = document.getElementById('green');\n  const blueInput = document.getElementById('blue');\n  const redValue = document.getElementById('red-value');\n  const greenValue = document.getElementById('green-value');\n  const blueValue = document.getElementById('blue-value');\n  const preview = document.getElementById('preview');\n  const hexOutput = document.getElementById('hex');\n  const randomBtn = document.getElementById('random');\n\n  function clamp(value) {\n    return Math.max(0, Math.min(255, Math.round(Number(value) || 0)));\n  }\n\n  function toHex(r, g, b) {\n    return '#' + [r, g, b]\n      .map(function (n) { return n.toString(16).padStart(2, '0'); })\n      .join('')\n      .toUpperCase();\n  }\n\n  function render() {\n    const r = clamp(redInput.value);\n    const g = clamp(greenInput.value);\n    const b = clamp(blueInput.value);\n\n    redInput.value = r;\n    greenInput.value = g;\n    blueInput.value = b;\n\n    redValue.textContent = r;\n    greenValue.textContent = g;\n    blueValue.textContent = b;\n\n    const hex = toHex(r, g, b);\n    hexOutput.textContent = hex;\n    preview.style.background = hex;\n    preview.style.backgroundColor = hex;\n  }\n\n  function randomChannel() {\n    return Math.floor(Math.random() * 256);\n  }\n\n  function randomize() {\n    redInput.value = randomChannel();\n    greenInput.value = randomChannel();\n    blueInput.value = randomChannel();\n    render();\n  }\n\n  redInput.addEventListener('input', render);\n  greenInput.addEventListener('input', render);\n  blueInput.addEventListener('input', render);\n  randomBtn.addEventListener('click', randomize);\n\n  render();\n})();",
      "description": "Sets both background shorthand and background-color so the preview swatch reliably reflects the mixed color."
