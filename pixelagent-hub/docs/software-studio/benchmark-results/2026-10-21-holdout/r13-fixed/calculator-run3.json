      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Pixel Calculator</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    background: #1a1a2e;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 100vh;\n    font-family: 'Courier New', monospace;\n    font-size: 18px;\n    color: #e0e0e0;\n    padding: 20px;\n  }\n  .card {\n    background: #16213e;\n    border: 4px solid #0f3460;\n    border-radius: 0;\n    padding: 30px;\n    width: 100%;\n    max-width: 420px;\n    display: flex;\n    flex-direction: column;\n    gap: 18px;\n    box-shadow: 8px 8px 0 #0f3460;\n  }\n  h1 {\n    font-size: 22px;\n    text-align: center;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: #e94560;\n    text-shadow: 2px 2px 0 #0f3460;\n    margin-bottom: 6px;\n  }\n  label {\n    display: block;\n    font-size: 16px;\n    margin-bottom: 4px;\n    color: #a0a0c0;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n  }\n  input, select, button {\n    width: 100%;\n    padding: 12px;\n    font-family: inherit;\n    font-size: 18px;\n    background: #0f3460;\n    color: #e0e0e0;\n    border: 3px solid #1a1a2e;\n    border-radius: 0;\n    outline: none;\n  }\n  input:focus, select:focus, button:focus-visible {\n    border-color: #e94560;\n    box-shadow: 0 0 0 3px rgba(233, 69, 96, 0.4);\n  }\n  input:hover, select:hover {\n    border-color: #a0a0c0;\n  }\n  button {\n    cursor: pointer;\n    background: #e94560;\n    color: #fff;\n    font-weight: bold;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    border: 3px solid #0f3460;\n    transition: transform 0.05s, background 0.1s;\n  }\n  button:hover { background: #ff5c77; }\n  button:active { transform: translate(2px, 2px); background: #c7354e; }\n  .result-box {\n    background: #0a0a1a;\n    border: 3px solid #0f3460;\n    padding: 16px;\n    text-align: right;\n    font-size: 24px;\n    min-height: 60px;\n    color: #e94560;\n    overflow-wrap: break-word;\n  }\n  .result-label {\n    font-size: 14px;\n    color: #a0a0c0;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    margin-bottom: 4px;\n  }\n  @media (max-width: 400px) {\n    .card { padding: 20px; }\n    body { font-size: 16px; }\n  }\n  [hidden] { display: none !important; }\n</style>\n</head>\n<body>\n<main class=\"card\">\n  <h1>Pixel Calc</h1>\n  <div>\n    <label for=\"left\">Left Number</label>\n    <input type=\"text\" id=\"left\" inputmode=\"decimal\" placeholder=\"e.g. -5.5\" autocomplete=\"off\">\n  </div>\n  <div>\n    <label for=\"operation\">Operation</label>\n    <select id=\"operation\">\n      <option value=\"add\">Add (+)</option>\n      <option value=\"subtract\">Subtract (−)</option>\n      <option value=\"multiply\">Multiply (×)</option>\n      <option value=\"divide\">Divide (÷)</option>\n    </select>\n  </div>\n  <div>\n    <label for=\"right\">Right Number</label>\n    <input type=\"text\" id=\"right\" inputmode=\"decimal\" placeholder=\"e.g. 3\" autocomplete=\"off\">\n  </div>\n  <button id=\"calculate\" type=\"button\">Calculate</button>\n  <div>\n    <div class=\"result-label\">Result</div>\n    <output id=\"result\" class=\"result-box\" for=\"left right operation calculate\">0</output>\n  </div>\n</main>\n<script>\n  const leftInput = document.getElementById('left');\n  const rightInput = document.getElementById('right');\n  const opSelect = document.getElementById('operation');\n  const calcBtn = document.getElementById('calculate');\n  const resultEl = document.getElementById('result');\n\n  function calculate() {\n    const leftStr = leftInput.value.trim();\n    const rightStr = rightInput.value.trim();\n    if (leftStr === '' || rightStr === '') {\n      resultEl.textContent = 'Error';\n      return;\n    }\n    const a = Number(leftStr);\n    const b = Number(rightStr);\n    if (!Number.isFinite(a) || !Number.isFinite(b)) {\n      resultEl.textContent = 'Error';\n      return;\n    }\n    const op = opSelect.value;\n    let result;\n    switch (op) {\n      case 'add': result = a + b; break;\n      case 'subtract': result = a - b; break;\n      case 'multiply': result = a * b; break;\n      case 'divide':\n        if (b === 0) { resultEl.textContent = 'Error'; return; }\n        result = a / b;\n        break;\n      default: resultEl.textContent = 'Error'; return;\n    }\n    if (!Number.isFinite(result)) {\n      resultEl.textContent = 'Error';\n      return;\n    }\n    resultEl.textContent = String(result);\n  }\n\n  calcBtn.addEventListener('click', calculate);\n</script>\n</body>\n</html>",
