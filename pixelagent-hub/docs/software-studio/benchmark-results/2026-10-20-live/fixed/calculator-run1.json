  "files": [
    {
      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Calculator</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Pixel Calculator</h1>\n    <form id=\"calc-form\" autocomplete=\"off\">\n      <div class=\"field\">\n        <label for=\"left\">Left number</label>\n        <input id=\"left\" name=\"left\" type=\"text\" inputmode=\"decimal\" placeholder=\"e.g. -5.2\" aria-describedby=\"hint\">\n      </div>\n      <div class=\"field\">\n        <label for=\"right\">Right number</label>\n        <input id=\"right\" name=\"right\" type=\"text\" inputmode=\"decimal\" placeholder=\"e.g. 3\" aria-describedby=\"hint\">\n      </div>\n      <div class=\"field\">\n        <label for=\"operation\">Operation</label>\n        <select id=\"operation\">\n          <option value=\"add\">Add (+)</option>\n          <option value=\"subtract\">Subtract (−)</option>\n          <option value=\"multiply\">Multiply (×)</option>\n          <option value=\"divide\">Divide (÷)</option>\n        </select>\n      </div>\n      <button id=\"calculate\" type=\"submit\">Calculate</button>\n    </form>\n    <p id=\"hint\" class=\"hint\">Press Enter to calculate. Negative numbers allowed.</p>\n    <output id=\"result\" for=\"left right operation\" aria-live=\"polite\">0</output>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
      "description": ""
    },
    {
      "path": "style.css",
      "content": ":root {\n  --bg: #1a1a2e;\n  --card: #16213e;\n  --accent: #e94560;\n  --text: #f5f5f5;\n  --muted: #a0a0b0;\n  --border: #0f3460;\n  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  font-size: 18px;\n  line-height: 1.5;\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  background: var(--bg);\n  background-image: linear-gradient(45deg, #0f0f1a 25%, transparent 25%),\n                    linear-gradient(-45deg, #0f0f1a 25%, transparent 25%),\n                    linear-gradient(45deg, transparent 75%, #0f0f1a 75%),\n                    linear-gradient(-45deg, transparent 75%, #0f0f1a 75%);\n  background-size: 32px 32px;\n  color: var(--text);\n  padding: 16px;\n}\n\n.card {\n  background: var(--card);\n  border: 4px solid var(--accent);\n  box-shadow: 8px 8px 0 var(--border);\n  padding: 24px;\n  width: min(100%, 420px);\n  image-rendering: pixelated;\n}\n\nh1 {\n  margin: 0 0 16px;\n  font-size: 1.4rem;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  color: var(--accent);\n  text-shadow: 2px 2px 0 var(--border);\n}\n\n.field { margin-bottom: 16px; }\n\nlabel {\n  display: block;\n  margin-bottom: 4px;\n  font-size: 0.9rem;\n  color: var(--muted);\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\ninput, select {\n  width: 100%;\n  padding: 10px 12px;\n  font-size: 1rem;\n  font-family: inherit;\n  color: var(--text);\n  background: var(--bg);\n  border: 3px solid var(--border);\n  outline: none;\n}\n\ninput:focus, select:focus {\n  border-color: var(--accent);\n  box-shadow: 0 0 0 2px var(--accent);\n}\n\nbutton {\n  width: 100%;\n  padding: 12px;\n  font-size: 1.1rem;\n  font-family: inherit;\n  font-weight: bold;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  color: var(--bg);\n  background: var(--accent);\n  border: 3px solid var(--accent);\n  cursor: pointer;\n  transition: transform 0.05s, box-shadow 0.05s;\n  box-shadow: 4px 4px 0 var(--border);\n}\n\nbutton:hover { filter: brightness(1.1); }\nbutton:focus-visible { outline: 3px solid var(--text); outline-offset: 2px; }\nbutton:active { transform: translate(4px, 4px); box-shadow: none; }\n\n.hint {\n  margin: 12px 0 0;\n  font-size: 0.8rem;\n  color: var(--muted);\n}\n\n#result {\n  display: block;\n  margin-top: 16px;\n  padding: 16px;\n  font-size: 2rem;\n  font-weight: bold;\n  text-align: right;\n  background: var(--bg);\n  border: 3px solid var(--border);\n  color: var(--accent);\n  min-height: 2.5em;\n  word-break: break-all;\n}\n\n@media (max-width: 400px) {\n  .card { padding: 16px; }\n  h1 { font-size: 1.2rem; }\n  #result { font-size: 1.5rem; }\n}",
      "description": ""
    },
    {
      "path": "script.js",
      "content": "const form = document.getElementById('calc-form');\nconst leftInput = document.getElementById('left');\nconst rightInput = document.getElementById('right');\nconst operationSelect = document.getElementById('operation');\nconst resultEl = document.getElementById('result');\n\nfunction parseNumber(value) {\n  if (value.trim() === '') return NaN;\n  const num = Number(value);\n  return Number.isFinite(num) ? num : NaN;\n}\n\nfunction calculate() {\n  const left = parseNumber(leftInput.value);\n  const right = parseNumber(rightInput.value);\n\n  if (Number.isNaN(left) || Number.isNaN(right)) {\n    resultEl.textContent = 'Error';\n    return;\n  }\n\n  const op = operationSelect.value;\n  let result;\n\n  switch (op) {\n    case 'add': result = left + right; break;\n    case 'subtract': result = left - right; break;\n    case 'multiply': result = left * right; break;\n    case 'divide':\n      if (right === 0) {\n        resultEl.textContent = 'Error';\n        return;\n      }\n      result = left / right;\n      break;\n    default:\n      resultEl.textContent = 'Error';\n      return;\n  }\n\n  if (!Number.isFinite(result)) {\n    resultEl.textContent = 'Error';\n  } else {\n    resultEl.textContent = String(result);\n  }\n}\n\nform.addEventListener('submit', (e) => {\n  e.preventDefault();\n  calculate();\n});\n\n// Optional: allow pressing Enter from inputs to trigger calculation\n[leftInput, rightInput, operationSelect].forEach(el => {\n  el.addEventListener('keydown', (e) => {\n    if (e.key === 'Enter') {\n      e.preventDefault();\n      calculate();\n    }\n  });\n});",
