    {
      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Calculator</title>\n  <style>\n    :root {\n      --bg: #1a1a2e;\n      --card: #16213e;\n      --accent: #e94560;\n      --text: #eaeaea;\n      --input-bg: #0f3460;\n      --border: #533483;\n    }\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      background: var(--bg);\n      color: var(--text);\n      font-family: 'Courier New', monospace;\n      font-size: 18px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100vh;\n      padding: 16px;\n    }\n    .card {\n      background: var(--card);\n      border: 4px solid var(--border);\n      border-radius: 0;\n      padding: 24px;\n      width: 100%;\n      max-width: 400px;\n      box-shadow: 8px 8px 0 rgba(0,0,0,0.5);\n    }\n    h1 {\n      font-size: 1.6rem;\n      text-align: center;\n      margin-bottom: 20px;\n      color: var(--accent);\n      text-transform: uppercase;\n      letter-spacing: 2px;\n    }\n    .field {\n      margin-bottom: 16px;\n    }\n    label {\n      display: block;\n      margin-bottom: 6px;\n      font-size: 0.9rem;\n      color: var(--text);\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n    input, select, button {\n      width: 100%;\n      padding: 12px;\n      font-family: inherit;\n      font-size: 1rem;\n      background: var(--input-bg);\n      color: var(--text);\n      border: 2px solid var(--border);\n      border-radius: 0;\n      outline: none;\n    }\n    input:focus, select:focus, button:focus {\n      border-color: var(--accent);\n      box-shadow: 0 0 0 2px var(--accent);\n    }\n    input:hover, select:hover {\n      border-color: var(--accent);\n    }\n    button {\n      background: var(--accent);\n      color: var(--bg);\n      font-weight: bold;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      cursor: pointer;\n      margin-top: 8px;\n      transition: transform 0.1s, box-shadow 0.1s;\n    }\n    button:hover {\n      background: #ff5a7a;\n      box-shadow: 4px 4px 0 rgba(0,0,0,0.5);\n    }\n    button:active {\n      transform: translate(2px, 2px);\n      box-shadow: 2px 2px 0 rgba(0,0,0,0.5);\n    }\n    .result-box {\n      margin-top: 20px;\n      padding: 16px;\n      background: var(--input-bg);\n      border: 2px solid var(--border);\n      text-align: center;\n      font-size: 1.8rem;\n      font-weight: bold;\n      color: var(--accent);\n      word-break: break-all;\n      min-height: 60px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    @media (max-width: 400px) {\n      body { font-size: 16px; }\n      .card { padding: 16px; }\n      h1 { font-size: 1.3rem; }\n      .result-box { font-size: 1.4rem; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Pixel Calc</h1>\n    <div class=\"field\">\n      <label for=\"left\">Left Number</label>\n      <input type=\"text\" id=\"left\" inputmode=\"decimal\" placeholder=\"e.g. -5.5\" autocomplete=\"off\">\n    </div>\n    <div class=\"field\">\n      <label for=\"right\">Right Number</label>\n      <input type=\"text\" id=\"right\" inputmode=\"decimal\" placeholder=\"e.g. 3\" autocomplete=\"off\">\n    </div>\n    <div class=\"field\">\n      <label for=\"operation\">Operation</label>\n      <select id=\"operation\">\n        <option value=\"add\">Add (+)</option>\n        <option value=\"subtract\">Subtract (−)</option>\n        <option value=\"multiply\">Multiply (×)</option>\n        <option value=\"divide\">Divide (÷)</option>\n      </select>\n    </div>\n    <button id=\"calculate\" type=\"button\">Calculate</button>\n    <div class=\"result-box\" id=\"result\" aria-live=\"polite\">0</div>\n  </main>\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      const left = document.getElementById('left');\n      const right = document.getElementById('right');\n      const op = document.getElementById('operation');\n      const btn = document.getElementById('calculate');\n      const result = document.getElementById('result');\n\n      function calculate() {\n        const lStr = left.value.trim();\n        const rStr = right.value.trim();\n        if (lStr === '' || rStr === '') {\n          result.textContent = 'Error';\n          return;\n        }\n        const l = Number(lStr);\n        const r = Number(rStr);\n        if (!Number.isFinite(l) || !Number.isFinite(r)) {\n          result.textContent = 'Error';\n          return;\n        }\n        let res;\n        switch (op.value) {\n          case 'add': res = l + r; break;\n          case 'subtract': res = l - r; break;\n          case 'multiply': res = l * r; break;\n          case 'divide':\n            if (r === 0) {\n              result.textContent = 'Error';\n              return;\n            }\n            res = l / r;\n            break;\n          default:\n            result.textContent = 'Error';\n            return;\n        }\n        if (!Number.isFinite(res)) {\n          result.textContent = 'Error';\n          return;\n        }\n        result.textContent = String(res);\n      }\n\n      btn.addEventListener('click', calculate);\n      [left, right].forEach(el => {\n        el.addEventListener('keydown', e => {\n          if (e.key === 'Enter') calculate();\n        });\n      });\n    });\n  </script>\n</body>\n</html>",
      "description": ""
    },
