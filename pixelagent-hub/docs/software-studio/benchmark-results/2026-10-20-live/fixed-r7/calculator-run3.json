  "files": [
    {
      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Calculator</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Pixel Calculator</h1>\n    <div class=\"inputs\">\n      <label for=\"left\">Left</label>\n      <input id=\"left\" type=\"text\" inputmode=\"decimal\" placeholder=\"e.g. -5\" autocomplete=\"off\">\n      <label for=\"right\">Right</label>\n      <input id=\"right\" type=\"text\" inputmode=\"decimal\" placeholder=\"e.g. 3.2\" autocomplete=\"off\">\n    </div>\n    <label for=\"operation\">Operation</label>\n    <select id=\"operation\">\n      <option value=\"add\">Add (+)</option>\n      <option value=\"subtract\">Subtract (−)</option>\n      <option value=\"multiply\">Multiply (×)</option>\n      <option value=\"divide\">Divide (÷)</option>\n    </select>\n    <button id=\"calculate\" type=\"button\">Calculate</button>\n    <div class=\"result-box\">\n      <span class=\"result-label\">Result</span>\n      <output id=\"result\" for=\"left right operation\">0</output>\n    </div>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
      "description": ""
    },
    {
      "path": "styles.css",
      "content": ":root {\n  --bg: #1a1c2c;\n  --card: #2a2d45;\n  --accent: #ef7d57;\n  --text: #f4f4f4;\n  --muted: #a0a4b8;\n  --border: #5a5e7a;\n  --font: 'Courier New', Courier, monospace;\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--bg);\n  font-family: var(--font);\n  font-size: 18px;\n  color: var(--text);\n  padding: 16px;\n  image-rendering: pixelated;\n}\n\n.card {\n  background: var(--card);\n  padding: 24px 20px;\n  width: 100%;\n  max-width: 380px;\n  border: 4px solid var(--border);\n  box-shadow: 8px 8px 0 #0d0e14;\n}\n\nh1 {\n  margin: 0 0 20px;\n  font-size: 22px;\n  text-align: center;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n\nlabel {\n  display: block;\n  margin: 12px 0 4px;\n  font-size: 16px;\n  color: var(--muted);\n}\n\ninput, select, button {\n  font-family: var(--font);\n  font-size: 18px;\n  width: 100%;\n  padding: 10px 12px;\n  border: 3px solid var(--border);\n  background: var(--bg);\n  color: var(--text);\n  outline: none;\n}\n\ninput:focus, select:focus, button:focus-visible {\n  border-color: var(--accent);\n  box-shadow: 0 0 0 3px rgba(239, 125, 87, 0.4);\n}\n\nbutton {\n  margin-top: 20px;\n  cursor: pointer;\n  background: var(--accent);\n  color: #1a1c2c;\n  font-weight: bold;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  border-color: var(--accent);\n  transition: transform 0.05s, box-shadow 0.05s;\n}\n\nbutton:hover {\n  filter: brightness(1.1);\n}\n\nbutton:active {\n  transform: translate(2px, 2px);\n  box-shadow: 2px 2px 0 #0d0e14;\n}\n\n.result-box {\n  margin-top: 24px;\n  padding: 14px;\n  background: var(--bg);\n  border: 3px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.result-label {\n  font-size: 16px;\n  color: var(--muted);\n  text-transform: uppercase;\n}\n\n#result {\n  font-size: 24px;\n  font-weight: bold;\n  color: var(--accent);\n  word-break: break-all;\n  text-align: right;\n}\n\n@media (max-width: 400px) {\n  .card { padding: 18px 14px; }\n  h1 { font-size: 18px; }\n  input, select, button { font-size: 16px; padding: 9px 10px; }\n}",
      "description": ""
    },
    {
      "path": "script.js",
      "content": "const leftInput = document.getElementById('left');\nconst rightInput = document.getElementById('right');\nconst operationSelect = document.getElementById('operation');\nconst resultOutput = document.getElementById('result');\n\nfunction calculate() {\n  const leftRaw = leftInput.value.trim();\n  const rightRaw = rightInput.value.trim();\n  if (leftRaw === '' || rightRaw === '') {\n    resultOutput.textContent = 'Error';\n    return;\n  }\n  const left = Number(leftRaw);\n  const right = Number(rightRaw);\n  if (!Number.isFinite(left) || !Number.isFinite(right)) {\n    resultOutput.textContent = 'Error';\n    return;\n  }\n  let result;\n  switch (operationSelect.value) {\n    case 'add': result = left + right; break;\n    case 'subtract': result = left - right; break;\n    case 'multiply': result = left * right; break;\n    case 'divide':\n      if (right === 0) {\n        resultOutput.textContent = 'Error';\n        return;\n      }\n      result = left / right;\n      break;\n    default:\n      resultOutput.textContent = 'Error';\n      return;\n  }\n  resultOutput.textContent = String(result);\n}\n\ndocument.getElementById('calculate').addEventListener('click', calculate);\n\n[leftInput, rightInput].forEach(input => {\n  input.addEventListener('keydown', (event) => {\n    if (event.key === 'Enter') {\n      event.preventDefault();\n      calculate();\n    }\n  });\n});\n\nresultOutput.textContent = '0';",
