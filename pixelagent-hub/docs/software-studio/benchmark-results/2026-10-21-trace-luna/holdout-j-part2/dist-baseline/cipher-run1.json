  "files": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Pixel Caesar Cipher</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n  <script src=\"app.js\" defer></script>\n</head>\n<body>\n  <main class=\"card\">\n    <div class=\"pixel-mark\" aria-hidden=\"true\">▦</div>\n    <p class=\"eyebrow\">CLASSIC CIPHER · PIXEL EDITION</p>\n    <h1>Caesar Cipher</h1>\n    <p class=\"intro\">Shift each letter through the alphabet. Your punctuation and spacing stay put.</p>\n\n    <label for=\"message\">Your message</label>\n    <textarea id=\"message\" rows=\"5\" placeholder=\"Type or paste text here…\"></textarea>\n\n    <div class=\"shift-row\">\n      <label for=\"shift\">Shift amount</label>\n      <input id=\"shift\" type=\"number\" min=\"1\" max=\"25\" value=\"3\" inputmode=\"numeric\">\n    </div>\n\n    <div class=\"actions\">\n      <button id=\"encode\" type=\"button\">Encode <span aria-hidden=\"true\">→</span></button>\n      <button id=\"decode\" class=\"secondary\" type=\"button\">Decode <span aria-hidden=\"true\">←</span></button>\n    </div>\n\n    <label for=\"result\">Result</label>\n    <textarea id=\"result\" rows=\"5\" readonly aria-live=\"polite\" placeholder=\"Your result will appear here…\"></textarea>\n    <p class=\"hint\">Letters keep their case · Other characters are unchanged</p>\n  </main>\n</body>\n</html>",
      "description": "Accessible offline app structure and controls"
    },
    {
      "path": "styles.css",
      "content": ":root {\n  color-scheme: light;\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  font-size: 16px;\n  color: #202b3a;\n  background: #eaf0e8;\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  min-width: 320px;\n  min-height: 100vh;\n  margin: 0;\n  padding: 32px 16px;\n  display: grid;\n  place-items: center;\n  background-color: #eaf0e8;\n  background-image: linear-gradient(rgba(54, 83, 68, .055) 1px, transparent 1px), linear-gradient(90deg, rgba(54, 83, 68, .055) 1px, transparent 1px);\n  background-size: 24px 24px;\n}\n\n.card {\n  width: min(100%, 540px);\n  padding: clamp(24px, 6vw, 42px);\n  border: 2px solid #263b32;\n  border-radius: 8px;\n  background: #fffdf6;\n  box-shadow: 8px 8px 0 #b4c5ad;\n}\n\n.pixel-mark {\n  width: 48px;\n  height: 48px;\n  display: grid;\n  place-items: center;\n  border: 2px solid #263b32;\n  border-radius: 4px;\n  background: #d9e8c8;\n  color: #263b32;\n  font-size: 29px;\n  line-height: 1;\n}\n\n.eyebrow {\n  margin: 24px 0 8px;\n  color: #55735a;\n  font-size: .8rem;\n  font-weight: 750;\n  letter-spacing: .12em;\n}\n\nh1 { margin: 0; font-size: clamp(2rem, 8vw, 2.8rem); line-height: 1.1; letter-spacing: -.04em; }\n.intro { margin: 12px 0 28px; color: #56645c; line-height: 1.55; }\nlabel { display: block; margin: 0 0 8px; font-weight: 700; }\n\ntextarea, input {\n  width: 100%;\n  border: 2px solid #c7d1c5;\n  border-radius: 5px;\n  background: #fff;\n  color: #202b3a;\n  font: inherit;\n}\n\ntextarea { min-height: 116px; padding: 12px; resize: vertical; line-height: 1.5; }\ntextarea::placeholder { color: #859087; }\ntextarea[readonly] { background: #f2f5ed; }\n\ninput { width: 88px; min-height: 46px; padding: 8px 10px; }\n.shift-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 20px 0; }\n.shift-row label { margin: 0; }\n.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0 0 24px; }\n\nbutton {\n  min-height: 48px;\n  padding: 10px 14px;\n  border: 2px solid #263b32;\n  border-radius: 5px;\n  background: #365b45;\n  color: #fffdf6;\n  font: inherit;\n  font-weight: 750;\n  cursor: pointer;\n  transition: background-color .15s ease, transform .15s ease, box-shadow .15s ease;\n}\nbutton.secondary { background: #fffdf6; color: #263b32; }\nbutton:hover { background: #294936; }\nbutton.secondary:hover { background: #e7efdf; }\nbutton:active { transform: translateY(2px); box-shadow: inset 0 2px 3px rgba(0, 0, 0, .18); }\n:focus-visible { outline: 3px solid #d18b3a; outline-offset: 3px; }\n.hint { margin: 10px 0 0; color: #68756c; font-size: .9rem; }\n\n@media (max-width: 420px) {\n  body { padding: 20px 12px; }\n  .actions { grid-template-columns: 1fr; }\n}\n",
      "description": "Responsive pixel-themed styling with visible interaction states"
    },
    {
      "path": "app.js",
      "content": "const message = document.querySelector(\"#message\");\nconst shiftInput = document.querySelector(\"#shift\");\nconst result = document.querySelector(\"#result\");\n\nfunction transform(text, amount) {\n  return [...text].map((character) => {\n    const code = character.charCodeAt(0);\n    const base = code >= 65 && code <= 90 ? 65 : code >= 97 && code <= 122 ? 97 : null;\n    return base === null ? character : String.fromCharCode(((code - base + amount) % 26 + 26) % 26 + base);\n  }).join(\"\");\n}\n\nfunction run(direction) {\n  const shift = Number(shiftInput.value);\n  if (!Number.isInteger(shift) || shift < 1 || shift > 25) {\n    shiftInput.setCustomValidity(\"Enter a whole number from 1 to 25.\");\n    shiftInput.reportValidity();\n    shiftInput.focus();\n    return;\n  }\n  shiftInput.setCustomValidity(\"\");\n  result.value = transform(message.value, direction * shift);\n}\n\nshiftInput.addEventListener(\"input\", () => shiftInput.setCustomValidity(\"\"));\ndocument.querySelector(\"#encode\").addEventListener(\"click\", () => run(1));\ndocument.querySelector(\"#decode\").addEventListener(\"click\", () => run(-1));\n",
      "description": "Case-preserving Caesar encode and decode logic"
    }
  ]
